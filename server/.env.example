# ---- Core ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/chirp

# Any long random string used to sign JWTs
JWT_SECRET=change-me-to-a-long-random-string

# ---- OTP / email verification ----
# Set to "true" to skip email OTP entirely (accounts are created immediately).
# When true, Redis and SMTP are NOT required.
DISABLE_OTP=true
OTP_TTL_SECONDS=600

# Redis — only needed when DISABLE_OTP is false (local: redis://localhost:6379,
# or an Upstash / Redis Cloud URL)
REDIS_URL=

# SMTP — only needed when DISABLE_OTP is false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Cloudinary (image uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
